<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app talks to the backend over HTTPS domains (ag-studex /
         rg-studex.izcy.tech), so no cleartext exceptions are needed for them.
         Only loopback/emulator hosts remain for local development. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
